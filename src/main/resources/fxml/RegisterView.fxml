<?xml version="1.0" encoding="UTF-8" ?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import org.example.components.logo.LogoComponent?>
<AnchorPane
        xmlns="http://javafx.com/javafx/23"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.controller.RegisterController"
        stylesheets="@/css/style.css"
        AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
        AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
>
    <HBox prefWidth="900.0" prefHeight="550.0"
          AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <VBox alignment="TOP_LEFT" prefWidth="420.0" HBox.hgrow="ALWAYS" styleClass="main-pane">
            <padding>
                <Insets top="40.0" right="50.0" bottom="40.0" left="50.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <LogoComponent/>
            </HBox>

            <VBox alignment="CENTER_LEFT" spacing="14.0" VBox.vgrow="ALWAYS">

                <Label text="Create your account" styleClass="title-label"/>

                <VBox spacing="6">
                    <Label text="First Name" styleClass="field-label"/>
                    <TextField fx:id="txtFirstName" promptText="john" styleClass="text-input"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Last Name" styleClass="field-label"/>
                    <TextField fx:id="txtLastName" promptText="doe" styleClass="text-input"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Email Address" styleClass="field-label"/>
                    <TextField fx:id="txtEmail" promptText="name@example.com" styleClass="text-input"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Password" styleClass="field-label"/>
                    <PasswordField fx:id="txtPassword" promptText="••••••••" styleClass="text-input"/>
                </VBox>

                <Label fx:id="lblStatus" text="" styleClass="status-label"/>

                <Button text="Sign Up" onAction="#handleLogin" maxWidth="Infinity" styleClass="primary-btn"/>

                <HBox alignment="CENTER" spacing="5.0">
                    <Label text="Already have an account?" styleClass="subtitle"/>
                    <Hyperlink text="Login" onAction="#openLoginScreen" styleClass="link-button"/>
                </HBox>
            </VBox>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" prefWidth="450.0" alignment="CENTER" spacing="20.0" styleClass="hero-pane">
            <padding>
                <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
            </padding>

            <Label text="🤖" styleClass="hero-emoji"/>
            <Label text="AI-Driven Code Evaluation" styleClass="hero-title" textAlignment="CENTER" wrapText="true"/>
            <Label text="Automated Test Case Execution, Real-Time Time/Space Complexity Metrics, and Instant Gemini AI Debugging Suggestions."
                   styleClass="hero-description" textAlignment="CENTER" wrapText="true"/>
        </VBox>
    </HBox>
</AnchorPane>