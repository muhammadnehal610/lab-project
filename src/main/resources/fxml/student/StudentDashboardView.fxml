<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.layout.*?>
<?import org.example.components.logo.LogoComponent?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            stylesheets="@/css/style.css"
            fx:controller="org.example.controller.StudentDashboardController"
            prefWidth="1100.0" prefHeight="550.0"
            minWidth="900.0" minHeight="500.0">

    <ScrollPane fx:id="mainScrollPane" fitToWidth="true" styleClass="main-scroll-pane"
                AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <VBox>

            <HBox alignment="CENTER_LEFT" prefWidth="Infinity" spacing="10" styleClass="student-header">
                <LogoComponent/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox fx:id="profileHeaderBox" alignment="CENTER_RIGHT" spacing="10">
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                    <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="/images/profile.png"/>
                        <clip>
                            <javafx.scene.shape.Circle radius="20.0" centerX="20.0" centerY="20.0"/>
                        </clip>
                    </ImageView>
                    <HBox alignment="CENTER" spacing="5">
                        <Label fx:id="userName" text="John Doe" styleClass="student-name"/>
                        <Button fx:id="userDropdownBtn"/>
                    </HBox>
                </HBox>
            </HBox>

            <VBox styleClass="student-page-body" spacing="15.0">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <Label fx:id="welcomeTxt" styleClass="admin-page-heading"/>
                        <Label text="Ready to write some code today?" styleClass="admin-page-description"/>
                    </VBox>
                </HBox>

                <HBox spacing="16.0" alignment="CENTER">
                    <VBox spacing="6.0" styleClass="progress-card" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets bottom="12.0" left="16.0" right="16.0" top="12.0"/>
                        </padding>
                        <Label styleClass="card-title" text="Total Solved"/>
                        <Label fx:id="totalSolvedLabel" styleClass="card-value" text="0 / 0"/>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <ProgressBar fx:id="totalProgressBar" progress="0.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="custom-progress-bar, progress-total"/>
                            <Label fx:id="totalPercentageLabel" styleClass="card-percentage" text="0%"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="6.0" styleClass="progress-card" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets bottom="12.0" left="16.0" right="16.0" top="12.0"/>
                        </padding>
                        <Label styleClass="card-title" text="Easy Solved"/>
                        <Label fx:id="easySolvedLabel" styleClass="card-value" text="0 / 0"/>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <ProgressBar fx:id="easyProgressBar" progress="0.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="custom-progress-bar, progress-easy"/>
                            <Label fx:id="easyPercentageLabel" styleClass="card-percentage" text="0%"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="6.0" styleClass="progress-card" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets bottom="12.0" left="16.0" right="16.0" top="12.0"/>
                        </padding>
                        <Label styleClass="card-title" text="Medium Solved"/>
                        <Label fx:id="medSolvedLabel" styleClass="card-value" text="0 / 0"/>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <ProgressBar fx:id="medProgressBar" progress="0.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="custom-progress-bar, progress-easy"/>
                            <Label fx:id="medPercentageLabel" styleClass="card-percentage" text="0%"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="6.0" styleClass="progress-card" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets bottom="12.0" left="16.0" right="16.0" top="12.0"/>
                        </padding>
                        <Label styleClass="card-title" text="Hard Solved"/>
                        <Label fx:id="hardSolvedLabel" styleClass="card-value" text="0 / 0"/>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <ProgressBar fx:id="hardProgressBar" progress="0.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="custom-progress-bar, progress-hard"/>
                            <Label fx:id="hardPercentageLabel" styleClass="card-percentage" text="0%"/>
                        </HBox>
                    </VBox>
                </HBox>

                <HBox fx:id="categoryContainer" spacing="10.0" alignment="CENTER_LEFT">
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="search-box" prefWidth="300.0">
                        <TextField fx:id="searchField" promptText="Search questions..." styleClass="search-field"
                                   HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <ComboBox fx:id="difficultyDropdown" promptText="Difficulty" styleClass="dropdown-field"
                              prefWidth="120.0"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label styleClass="solved-count-label" fx:id="solvedCount" />
                </HBox>

                <VBox fx:id="problemListContainer" spacing="0.0" styleClass="problem-list-container">
                </VBox>

            </VBox>
        </VBox>
    </ScrollPane>
</AnchorPane>