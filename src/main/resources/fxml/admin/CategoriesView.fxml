<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Pagination?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.CategoryController">
    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                styleClass="page-scroll"
                AnchorPane.topAnchor="0"
                AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0">

        <VBox spacing="16.0" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="16.0"
              AnchorPane.rightAnchor="16.0"
              AnchorPane.topAnchor="16.0"
              styleClass="admin-page-wrap"
        >
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <Label text="Category Management" styleClass="admin-page-heading"/>
                    <Label text="Manage question categories, domains, and evaluation topics for tests."
                           styleClass="admin-page-description"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button onAction="#openAddCategory" text="Add Category" styleClass="btn-primary"/>
            </HBox>

            <HBox alignment="CENTER_LEFT"
                  styleClass="search-wrap">
            <TextField
                    fx:id="searchField"
                    promptText="Search categories..."
                    styleClass="search-field"
                    prefWidth="320"
            />
            </HBox>

            <VBox styleClass="table-wrap">
                <children>
                    <TableView fx:id="tableView">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="categoryName" text="Category Name" prefWidth="150">
                                <cellValueFactory>
                                    <PropertyValueFactory property="name"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="categorySlug" text="Slug" prefWidth="120">
                                <cellValueFactory>
                                    <PropertyValueFactory property="slug"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="categoryDescription" text="Description" prefWidth="250">
                                <cellValueFactory>
                                    <PropertyValueFactory property="description"/>
                                </cellValueFactory>
                            </TableColumn>

                            <TableColumn fx:id="categoryAction"
                                         text="Actions"
                                         prefWidth="100"/>
                        </columns>

                        <sortOrder>
                            <fx:reference source="categoryName"/>
                        </sortOrder>
                    </TableView>
                </children>
            </VBox>

            <HBox alignment="CENTER_RIGHT" styleClass="pagination-wrap">
                <Pagination
                        fx:id="pagination"
                        maxPageIndicatorCount="5"
                />
            </HBox>
        </VBox>
    </ScrollPane>
</AnchorPane>