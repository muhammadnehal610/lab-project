<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.AdminDashboardController"
            stylesheets="@/css/style.css"
            prefWidth="1100.0" prefHeight="550.0"
            minWidth="900.0" minHeight="500.0">

    <left>
        <VBox prefWidth="220.0" spacing="15.0" styleClass="admin-sidebar">
            <HBox styleClass="admin-sidebar-header">
                <Label text="Admin Portal" />
            </HBox>

            <VBox styleClass="admin-sidebar-body" spacing="20">
                <children>
                    <!-- Problems Item -->
                    <Button fx:id="btnProblems"
                            text="Problems"
                            onAction="#handleLoadProblems"
                            maxWidth="1.7976931348623157E308"
                            styleClass="admin-sidebar-nav-item, active">
                        <graphic>
                            <FontIcon iconLiteral="fth-code" styleClass="nav-icon" />
                        </graphic>
                    </Button>

                    <!-- Categories Item -->
                    <Button fx:id="btnCategories"
                            text="Categories"
                            onAction="#handleLoadCategories"
                            maxWidth="1.7976931348623157E308"
                            styleClass="admin-sidebar-nav-item">
                        <graphic>
                            <FontIcon iconLiteral="fth-grid" styleClass="nav-icon" />
                        </graphic>
                    </Button>
                </children>
            </VBox>



            <VBox VBox.vgrow="ALWAYS"/>

            <Button text="Logout" onAction="#handleLogout"
                    maxWidth="1.7976931348623157E308"
                    styleClass="admin-sidebar-logout-btn"/>
        </VBox>
    </left>

    <center>
        <BorderPane>
            <top>
                <VBox styleClass="admin-header" alignment="CENTER_LEFT">
                    <Label fx:id="headerUserName"  styleClass="header-user-name"/>
                    <Label fx:id="headerDate"  styleClass="header-date"/>
                </VBox>
            </top>
            <center>
                <StackPane fx:id="contentArea" styleClass="admin-outlet">
                </StackPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>
