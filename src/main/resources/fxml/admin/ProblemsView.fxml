<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Pagination?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.ProblemController">
    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                styleClass="page-scroll"
                AnchorPane.topAnchor="0"
                AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0">

        <VBox spacing="16.0" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="16.0"
              AnchorPane.rightAnchor="16.0"
              AnchorPane.topAnchor="16.0"
              styleClass="admin-page-wrap"
        >

            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <Label text="Problem Management" styleClass="admin-page-heading"/>
                    <Label text="Create and manage coding problems, set difficulty levels, and attach hidden test cases for automated evaluation."
                           styleClass="admin-page-description"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button onAction="#openAddProblem" text="Add Problem" styleClass="btn-primary"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10"
                  styleClass="search-wrap">
                <TextField
                        fx:id="searchField"
                        promptText="Search Problems..."
                        styleClass="search-field"
                        prefWidth="320"
                />

                <ComboBox fx:id="difficultyDropdown" styleClass="dropdown-field"
                          promptText="Difficulty"/>
                <ComboBox fx:id="categoriesDropdown" styleClass="dropdown-field"
                          promptText="Categories"/>
            </HBox>

            <VBox styleClass="table-wrap">
                <TableView fx:id="tableView">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="title" text="Title" prefWidth="220" minWidth="180"/>

                        <TableColumn fx:id="categoryName" text="Category" prefWidth="200" minWidth="160"/>

                        <TableColumn fx:id="difficulty" text="Difficulty" prefWidth="100" minWidth="90"
                                     maxWidth="110"/>

                        <TableColumn fx:id="sampleInput" text="Sample Input" prefWidth="250" minWidth="180"/>

                        <TableColumn fx:id="problemAction" text="Actions" prefWidth="140" minWidth="130"
                                     maxWidth="150"/>
                    </columns>

                    <sortOrder>
                        <fx:reference source="title"/>
                    </sortOrder>
                </TableView>
            </VBox>

            <HBox alignment="CENTER_RIGHT" styleClass="pagination-wrap">
                <Pagination
                        fx:id="pagination"
                        maxPageIndicatorCount="5"
                />
            </HBox>
        </VBox>
    </ScrollPane>
</AnchorPane>
