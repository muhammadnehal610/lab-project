<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Top tag ko fx:root banana zaroori hai -->
<fx:root type="javafx.scene.layout.VBox" prefWidth="420.0" spacing="16.0" styleClass="form-modal" stylesheets="/css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <children>
        <Label fx:id="formTitleLabel" styleClass="form-title" text="Add New Category" />

        <VBox spacing="6.0">
            <children>
                <Label styleClass="form-label" text="Category Name *" />
                <TextField fx:id="nameField" promptText="e.g. Web Development" styleClass="form-input" />
            </children>
        </VBox>

        <VBox spacing="6.0">
            <children>
                <Label styleClass="form-label" text="Slug *" />
                <TextField fx:id="slugField" promptText="e.g. web-development" styleClass="form-input" />
            </children>
        </VBox>

        <VBox spacing="6.0">
            <children>
                <Label styleClass="form-label" text="Description" />
                <TextArea fx:id="descriptionArea" prefRowCount="3" promptText="Enter category description..." styleClass="form-input-area" wrapText="true" />
            </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <children>
                <Button onAction="#handleCancel" styleClass="btn-secondary" text="Cancel" />
                <Button fx:id="saveBtn" onAction="#handleSave" styleClass="btn-primary" text="Save Category" />
            </children>
            <VBox.margin>
                <Insets top="8.0" />
            </VBox.margin>
        </HBox>
    </children>
</fx:root>