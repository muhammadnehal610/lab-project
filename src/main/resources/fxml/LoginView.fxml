<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import org.example.components.logo.LogoComponent?>

<AnchorPane xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.LoginController"
            stylesheets="@/css/style.css"
            AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

    <HBox prefWidth="900.0" prefHeight="500.0"
          AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <!-- Left Form Pane -->
        <!-- Left Form Pane -->
        <VBox alignment="TOP_LEFT" prefWidth="420.0" HBox.hgrow="ALWAYS" styleClass="main-pane">
            <padding>
                <Insets top="40.0" right="50.0" bottom="40.0" left="50.0"/>
            </padding>

            <!-- 1. Logo Section (Ab ye strict top par rahega) -->
            <HBox alignment="CENTER_LEFT">
                <LogoComponent />
            </HBox>

            <!-- 2. Form Section (Ye automatically remaining space le kar center ho jayega) -->
            <VBox alignment="CENTER_LEFT" spacing="14.0" VBox.vgrow="ALWAYS">

                <Label text="Sign in to your account" styleClass="title-label"/>

                <VBox spacing="6.0">
                    <Label text="Email Address" styleClass="field-label"/>
                    <TextField fx:id="txtEmail" promptText="name@example.com" styleClass="text-input"/>
                </VBox>

                <VBox spacing="6.0">
                    <Label text="Password" styleClass="field-label"/>
                    <PasswordField fx:id="txtPassword" promptText="••••••••" styleClass="text-input"/>
                </VBox>

                <Label fx:id="lblStatus" text="" styleClass="status-label"/>

                <Button fx:id="loginBtn" text="Sign In" onAction="#handleLogin" maxWidth="Infinity" styleClass="primary-btn"/>

                <HBox alignment="CENTER" spacing="5.0">
                    <Label text="Don't have an account?" styleClass="subtitle"/>
                    <Hyperlink text="Sign up" onAction="#openRegisterScreen" styleClass="link-button"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- Right Hero Pane -->
        <VBox HBox.hgrow="ALWAYS" prefWidth="480.0" alignment="CENTER" spacing="16.0" styleClass="hero-pane">
            <padding>
                <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
            </padding>

            <Label text="&lt;/&gt;" styleClass="hero-icon"/>
            <Label text="Compile. Test. Evaluate." styleClass="hero-title" textAlignment="CENTER" wrapText="true"/>
            <Label text="Isolated local CLI compilation engine with real-time test case verification."
                   styleClass="hero-description" textAlignment="CENTER" wrapText="true"/>
        </VBox>
    </HBox>
</AnchorPane>